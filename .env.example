# Copiá este archivo como .env.local (no se sube a GitHub) para probar la sincronización con npm run dev.
# En Vercel, cargá las mismas variables en Settings → Environment Variables.

# Base de Turso: libsql://<base>-<usuario>.turso.io  (para probar sin Turso: file:.data/dev.db)
TURSO_DATABASE_URL=
# Token de la base (Turso → tu base → Create Token). Con file: se deja vacío.
TURSO_AUTH_TOKEN=
# Tu contraseña para entrar desde la app
APP_PASSWORD=
